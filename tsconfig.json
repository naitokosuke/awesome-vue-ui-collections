{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite-plus/client", "node", "unplugin-icons/types/vue"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "build/**/*.ts", "vite.config.ts"]
}
